  ],
  "applicationFiles": [
    {"path": "command/Register{entity}Command.java", "name": "Register{entity}Command", "kind": "record"},
    {"path": "command/Update{entity}Command.java", "name": "Update{entity}Command", "kind": "record"},
    {"path": "dto/{entity}Response.java", "name": "{entity}Response", "kind": "record"},
