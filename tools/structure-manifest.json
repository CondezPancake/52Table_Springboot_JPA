    {"path": "adapters/in/rest/dtos/Update{entity}Request.java", "name": "Update{entity}Request", "kind": "record"},
    {"path": "adapters/out/persistence/entity/{entity}JpaEntity.java", "name": "{entity}JpaEntity", "kind": "class"},
    {"path": "adapters/out/persistence/mappers/{entity}PersistenceMapper.java", "name": "{entity}PersistenceMapper", "kind": "class"},
    {"path": "adapters/out/persistence/repositories/{entity}JpaRepository.java", "name": "{entity}JpaRepository", "kind": "interface", "extends": "JpaRepository"},
